<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nike Clone | Just Do It</title>
    <link rel="stylesheet" href="/style.css" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  </head>
  <body>
    <header>
      <nav class="navbar">
        <div class="logo">
          <a href="/" style="text-decoration: none; color: inherit;"><h1>NIKE</h1></a>
        </div>
        <ul class="nav-links" id="navLinks">
          <li><a href="#">New & Featured</a></li>
          <li><a href="#">Men</a></li>
          <li><a href="/products">All Products</a></li>
          <% if (currentUser) { %>
            <% if (currentUser.role === 'admin') { %>
              <li><a href="/admin" style="color: #ff5722;">Admin Panel</a></li>
              <li><a href="/sales" style="color: #4caf50;">Sales Dashboard</a></li>
            <% } %>
            <li><a href="/logout">Logout (<%= currentUser.name %>)</a></li>
          <% } else { %>
            <li><a href="/login">Login / Register</a></li>
          <% } %>
        </ul>
        <div class="hamburger" id="hamburger">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </nav>
    </header>

    <main>
      <%- include('partials/flash') %>
      <%- body %>
    </main>

    <footer class="footer">
      <div class="footer-container">
        <div class="footer-col">
          <ul class="footer-bold-links">
            <li><a href="#">FIND A STORE</a></li>
            <li><a href="#">BECOME A MEMBER</a></li>
            <li><a href="#">Send Us Feedback</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>GET HELP</h4>
          <ul>
            <li><a href="#">Order Status</a></li>
            <li><a href="#">Delivery</a></li>
            <li><a href="#">Returns</a></li>
            <li><a href="#">Payment Options</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>ABOUT NIKE</h4>
          <ul>
            <li><a href="#">News</a></li>
            <li><a href="#">Careers</a></li>
            <li><a href="#">Investors</a></li>
            <li><a href="#">Sustainability</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 Nike, Inc. All Rights Reserved</p>
        <div class="bottom-links">
          <a href="#">Guides</a>
          <a href="#">Terms of Sale</a>
          <a href="#">Privacy Policy</a>
        </div>
      </div>
    </footer>

    <script src="/script.js"></script>
  </body>
</html>
